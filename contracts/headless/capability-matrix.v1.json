      "queries": ["project.overview", "project.timeline", "project.trace", "events.read", "operation.status", "command.receipt", "requirements.coverage", "attempts.compare", "approvals.queue", "environment.report", "archive.status"],
      "scope": "bound_project"
    },
    "context.read": {"status": "available", "queries": ["context.resolve"], "scope": "bound_project", "persistence": "read_only_preview"},
    "knowledge.read": {"status": "available", "queries": ["context.resolve"], "scope": "bound_project", "persistence": "ledger_revisions_only"},
    "knowledge.search": {"status": "unavailable", "queries": ["knowledge.search"], "reason": "no versioned search contract or RPC handler is wired"},
