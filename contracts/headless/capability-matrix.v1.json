    "trace.read": {"status": "available", "queries": ["project.trace"], "required_capabilities": ["project.read"], "replay": ["root_ref", "direction", "max_depth", "as_of_seq"]},
    "design.dispatch": {"status": "planned", "phase": "H2", "required_capabilities": ["design.write", "dispatch.confirm"]},
    "execute.verify": {"status": "planned", "phase": "H2", "required_capabilities": ["attempt.execute", "verification.review"]}
  }
}
