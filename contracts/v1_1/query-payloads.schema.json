{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-kernel.invalid/design/v1_1/query-payloads.schema.json",
  "title": "Query-specific payload schema for protocol 1.1.0 (incremental)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "const": "context.sync"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "watermark": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "commit_seq": {
                  "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/seq"
                },
                "event_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "required": [
                "commit_seq",
                "event_index"
              ]
            },
            "known_digests": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "object_type": {
                    "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/id"
                  },
                  "object_id": {
                    "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/id"
                  },
                  "revision_id": {
                    "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/id"
                  },
                  "digest": {
                    "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/digest"
                  }
                },
                "required": [
                  "object_type",
                  "object_id",
                  "revision_id",
                  "digest"
                ]
              }
            },
            "known_index_digest": {
              "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/digest"
            },
            "object_types": {
              "type": "array",
              "minItems": 0,
              "items": {
                "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/id"
              }
            },
            "inline": {
              "type": "string",
              "enum": [
                "changed",
                "mandatory",
                "none"
              ]
            },
            "mandatory_refs": {
              "type": "array",
              "minItems": 0,
              "items": {
                "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/object_ref"
              }
            },
            "max_rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_body_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": [
            "purpose"
          ]
        }
      },
      "required": [
        "query",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "const": "records.changed_since"
        },
        "payload": {
          "$ref": "https://project-kernel.invalid/design/v1_1/query-payloads.schema.json#/oneOf/0/properties/payload"
        }
      },
      "required": [
        "query",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "const": "records.get"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "object_ref": {
              "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/object_ref"
            },
            "known_digest": {
              "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/digest"
            },
            "max_body_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": [
            "purpose",
            "object_ref"
          ]
        }
      },
      "required": [
        "query",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "const": "execution.records"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "record_types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "as_of_seq": {
              "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/seq"
            }
          },
          "required": []
        }
      },
      "required": [
        "query",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "const": "evidence.read"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_ref": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "object_type": {
                  "const": "artifact"
                },
                "object_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "revision_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "required": [
                "object_type",
                "object_id"
              ]
            },
            "max_inline_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            }
          },
          "required": []
        }
      },
      "required": [
        "query",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "const": "module.describe"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "module_id"
          ]
        }
      },
      "required": [
        "query",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "const": "module.validate"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo_root": {
              "type": "string",
              "minLength": 1
            },
            "module_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repo_root",
            "module_id"
          ]
        }
      },
      "required": [
        "query",
        "payload"
      ]
    },
    {
      "$ref": "https://project-kernel.invalid/design/v1/query-payloads.schema.json"
    }
    ,
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "const": "execution_flow.task_workflow" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_ref": { "$ref": "https://project-kernel.invalid/design/v1_1/command-payloads.schema.json#/$defs/execution_flow_exact_ref" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "required": ["task_ref"]
        }
      },
      "required": ["query", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "const": "capabilities.describe" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      "required": ["query", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "const": "skills.relevant" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_ref": {
              "$ref": "https://project-kernel.invalid/design/v1/common.schema.json#/$defs/object_ref"
            },
            "record_types": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "enum": ["skill", "error"] }
            },
            "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        }
      },
      "required": ["query", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "const": "profile.view" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      "required": ["query", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "const": "supervisor.report" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      "required": ["query", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "const": "supervisor.events" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      "required": ["query", "payload"]
    }
  ]
}
